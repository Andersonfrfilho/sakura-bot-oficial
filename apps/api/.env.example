# Servidor
# Railway injeta PORT automaticamente — não setar no dashboard Railway
PORT=3333
NODE_ENV=development

# Banco de dados
# Local: hostname do serviço Docker Compose
# Railway: referência ao plugin PostgreSQL (${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://botuser:senha@postgres:5432/botdb

# Redis
# Local: hostname do serviço Docker Compose
# Railway: referência ao plugin Redis (${{Redis.REDIS_URL}})
REDIS_URL=redis://redis:6379

# Auth — gerar com: openssl rand -hex 32
JWT_SECRET=troque_para_string_aleatoria_de_32_chars_minimo
JWT_REFRESH_SECRET=troque_para_outra_string_aleatoria_diferente
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Webhook (compartilhado com o n8n)
WEBHOOK_SECRET=hmac_secret_compartilhado_com_n8n

# CORS — origens permitidas separadas por vírgula
ALLOWED_ORIGINS=http://localhost:4000,https://seu-web.up.railway.app

# Log
LOG_LEVEL=info

# ─── Fiscal (NFC-e/SAT) ───────────────────────────────────────────────
# Criptografia AES-256 do certificado A1 + senha em repouso — gerar: openssl rand -hex 32
APP_SECRET=troque_para_string_aleatoria_de_32_chars_minimo
# Liga o worker de emissão fiscal (BullMQ) neste processo. Em produção pode virar app dedicado.
FISCAL_WORKER_ENABLED=true
# HMAC dos links públicos da nota (/nota/:token) — gerar: openssl rand -hex 32
FISCAL_PUBLIC_TOKEN_SECRET=troque_para_outra_string_aleatoria_diferente
# Intervalo da varredura de reprocessamento offline (ms) — default 120000 (2min)
FISCAL_SWEEP_INTERVAL_MS=120000
# Envio ao cliente por e-mail — escolha o provider em fiscal_configurations.email_provider
RESEND_API_KEY=
SMTP_URL=
# Envio ao cliente por WhatsApp — webhook interno do n8n que dispara a mensagem
# URL publica do web (base do link /nota/:token enviado ao cliente)
WEB_PUBLIC_URL=http://localhost:4000
# Remetente dos e-mails de nota fiscal
FISCAL_EMAIL_FROM=notas@seu-dominio.com
N8N_FISCAL_WEBHOOK_URL=
# Bull Board (dashboard da fila) — porta propria, protegido por basic auth. So habilita se BULLBOARD_PASS setado.
BULLBOARD_PORT=4200
BULLBOARD_USER=admin
BULLBOARD_PASS=
